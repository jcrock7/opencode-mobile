{
  "//": "Production-shaped settings. Every {{placeholder}} is provisioned in docs/authentication.md. Secrets never live here.",

  "TokenValidation": {
    "Audiences": [ "{{AgentAppId}}" ],
    "TenantId": "{{TenantId}}"
  },

  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "FederatedCredentials",
        "ClientId": "{{AgentAppId}}",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "FederatedClientId": "{{ManagedIdentityClientId}}",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    { "ServiceUrl": "*", "Connection": "ServiceConnection" }
  ],

  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": true,
    "NormalizeMentions": true
  },

  "Identity": {
    "Mode": "ManagedIdentity",
    "ManagedIdentityClientId": "{{ManagedIdentityClientId}}"
  },

  "AzureOpenAI": {
    "Endpoint": "https://{{AzureOpenAIResource}}.openai.azure.com",
    "Deployment": "gpt-5.4-mini",
    "Scope": "https://ai.azure.com/.default"
  },

  "Mcp": {
    "Servers": [
      {
        "Name": "purchasing",
        "Endpoint": "https://mcp-purchasing.contoso.com/",
        "Scope": "https://mcp-purchasing.contoso.com/.default",
        "AllowedTools": [ "get_purchase_order", "list_held_purchase_orders", "get_vendor_profile", "release_purchase_order_hold" ]
      },
      {
        "Name": "land",
        "Endpoint": "https://mcp-land.contoso.com/",
        "Scope": "https://mcp-land.contoso.com/.default",
        "AllowedTools": [
          "get_lease_metadata", "list_leases_pending_review", "get_lease_document", "get_tract_title",
          "get_mineral_ownership", "get_lease_form_standards",
          "record_lease_review", "create_curative_task", "update_lease_status"
        ]
      }
    ]
  },

  "Approvals": {
    "TenantId": "{{TenantId}}",
    "ServiceUrl": "https://smba.trafficmanager.net/teams/",
    "Default": { "UserObjectId": "{{DefaultApproverObjectId}}" },
    "Routes": [
      { "CaseType": "PurchaseOrderHold", "UserObjectId": "{{ApApproverObjectId}}", "TeamsChannelId": null },
      { "CaseType": "LeaseReview", "Attribute": "state", "Value": "PA", "UserObjectId": "{{LandManagerPaObjectId}}", "TeamsChannelId": "{{LandTeamPaChannelId}}" },
      { "CaseType": "LeaseReview", "UserObjectId": "{{LandManagerObjectId}}", "TeamsChannelId": null }
    ]
  },

  "Storage": {
    "BlobConnectionString": null,
    "BlobContainer": "agent-state"
  },

  "Workflow": {
    "CheckpointDirectory": "/home/data/checkpoints",
    "PendingDecisionDirectory": "/home/data/pending"
  },

  "Triggers": {
    "Schedule": { "Enabled": false, "IntervalMinutes": 15, "Cases": [] }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents": "Information",
      "Microsoft.Agents.Authentication.Msal": "Warning"
    }
  },
  "AllowedHosts": "*"
}
