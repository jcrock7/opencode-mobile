<Project>
  <ItemGroup>
    <!-- Microsoft Agent Framework: orchestration, workflows, model clients -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />

    <!-- Model Context Protocol: official C# SDK (client + ASP.NET Core server) -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!-- Microsoft 365 Agents SDK: Teams channel hosting, activity protocol, proactive messaging -->
    <PackageVersion Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.8.77" />
    <PackageVersion Include="Microsoft.Agents.Authentication.Msal" Version="1.8.77" />
    <PackageVersion Include="Microsoft.Agents.Storage.Blobs" Version="1.8.77" />

    <!-- Identity -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />

    <!-- Hosting abstractions used by the core library -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
